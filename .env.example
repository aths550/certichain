# Pinata IPFS Credentials
PINATA_API_KEY=your_pinata_key_here
PINATA_SECRET=your_pinata_secret_here

# Blockchain Network Config
# Get Sepolia RPC from Alchemy (https://www.alchemy.com/) or Infura
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key

# MetaMask Private Key (Exported from Account Details)
# WARNING: NEVER SHARE THIS KEY OR COMMIT TO GITHUB
PRIVATE_KEY=0x_your_private_key_without_0x_prefix

# Hardhat Node Config (Optional)
HARDHAT_LOCAL_URL=http://127.0.0.1:8545
